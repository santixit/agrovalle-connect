@startuml AgroValle_Sequence_HU01_HU02
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
title Secuencias REST de registro y publicacion

box "HU-01 Registro de agricultor"
actor Persona
participant "AgricultorController" as AC
participant "AgricultorService" as AS
participant "AgricultorRepository" as AR
participant "UsuarioRepository" as UR
participant "UsuarioFactory" as UF
database PostgreSQL as DB

Persona -> AC: POST /api/v1/auth/register\nRegistroAgricultorRequest
AC -> AC: validar @Valid
AC -> AS: registrar(request)
AS -> AR: existsByCedula(cedula)
AR -> DB: SELECT por cedula
DB --> AR: existe / no existe
AR --> AS: resultado
alt cedula duplicada
  AS --> AC: CedulaDuplicadaException
  AC --> Persona: 409 Conflict
else cedula disponible
  opt correo y contrasena presentes
    AS -> UR: existsByCorreoIgnoreCase(correo)
    UR -> DB: SELECT por correo
    DB --> UR: resultado
    UR --> AS: no existe
    AS -> UF: crearAgricultor(correo, contrasena)
    UF --> AS: Usuario con hash BCrypt
    AS -> UR: save(usuario)
    UR -> DB: INSERT usuarios
    DB --> UR: usuario persistido
  end
  AS -> AR: save(agricultor)
  AR -> DB: INSERT agricultores
  DB --> AR: agricultor persistido
  AR --> AS: Agricultor
  AS -> AS: AgricultorResponse.from(agricultor)
  AS --> AC: respuesta publica
  AC --> Persona: 201 Created + Location
end
end box

newpage
box "HU-02 Publicacion de cosecha"
actor Agricultor
participant "ProductoController" as PC
participant "ProductoService" as PS
participant "AgricultorRepository" as AR2
participant "FincaRepository" as FR
participant "ProductoRepository" as PR
database PostgreSQL as DB2

Agricultor -> PC: POST /api/v1/productos\nBearer JWT + PublicarProductoRequest
PC -> PC: validar @Valid
PC -> PS: publicar(usuarioId, request)
PS -> AR2: findByUsuario_Id(usuarioId)
AR2 -> DB2: SELECT agricultor autenticado
DB2 --> AR2: agricultor
AR2 --> PS: Agricultor
opt fincaId enviado
  PS -> FR: findByIdAndAgricultor_Id(fincaId, agricultorId)
  FR -> DB2: SELECT finca propia
  DB2 --> FR: Finca o no encontrada
  FR --> PS: resultado
end
PS -> PS: construir Producto
PS -> PR: save(producto)
PR -> DB2: INSERT productos
DB2 --> PR: producto persistido
PR --> PS: Producto
PS -> PS: ProductoResponse.from(producto)
PS --> PC: respuesta publica
PC --> Agricultor: 201 Created + Location
end box
@enduml
