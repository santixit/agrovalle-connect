# Maven
target/
*.class
# Ignore local Maven configuration and binaries, but keep wrapper configuration required by mvnw.
.mvn/*
!.mvn/wrapper/
.mvn/wrapper/*
!.mvn/wrapper/maven-wrapper.properties
.mvn/wrapper/maven-wrapper.jar

# IDEs
.idea/
*.iml
.project
.classpath
.settings/
.vscode/

# Node and Husky
node_modules/
playwright-report/
test-results/

# Python helper scripts
__pycache__/
*.py[cod]
.venv/

# Temporary files created while building delivery PDFs
tmp/
/output/pdf/

# Operating system and secrets
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
*.log
*.pem

.neon
